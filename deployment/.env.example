# Rybella Iraq - Production Environment Variables
# Copy to deployment/.env

HTTP_PORT=4000
WEBSTORE_PORT=4003

# PostgreSQL (مطلوب)
POSTGRES_DB=rybella
POSTGRES_USER=rybella
POSTGRES_PASSWORD=change_this_strong_postgres_password
PG_POOL_MAX=50
WEB_CONCURRENCY=2

JWT_SECRET=change_this_to_a_strong_random_secret_in_production
JWT_EXPIRES_IN=7d

API_URL=https://rybellairaq.com

MAX_FILE_SIZE=5242880

EXTERNAL_INVENTORY_API_URL=http://187.127.88.146/api/v1
EXTERNAL_INVENTORY_API_EMAIL=
EXTERNAL_INVENTORY_API_PASSWORD=
EXTERNAL_INVENTORY_API_TOKEN=
INVENTORY_SYNC_INTERVAL_MIN=30
